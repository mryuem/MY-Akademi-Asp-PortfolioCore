@model Contact
@{
    ViewData["Title"] = "UpdateContact";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<h2>Güncelleme Sayası</h2>

<form method="post">
    <input  type="hidden" asp-for="ContactId"/>
    <label>Adı</label>
    <input  type="text" asp-for="Name" class="form-control" style="border:1px solid black"/>
    <br />
    <label>Telefon</label>
    <input  type="tel" asp-for="PhoneNumber" class="form-control" style="border:1px solid black"/>
    <br />
    <label>Email</label>
    <input  type="email" asp-for="Email" class="form-control" style="border:1px solid black"/>
    <br />
    <label>Adres</label>
    <input  type="text" asp-for="Location" class="form-control" style="border:1px solid black"/>
    <br />
    <button class="btn btn-success">Kaydet</button>
</form>