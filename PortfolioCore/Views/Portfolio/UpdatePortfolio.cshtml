@model Portfolio
@{
    ViewData["Title"] = "UpdatePortfolio";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<h2>Güncelleme Sayfası</h2>

<form method="post">
    <input type="hidden" asp-for="PortfolioId" />
    <label>Başlık</label>
    <input type="text" asp-for="Title" class="form-control" style="border:1px solid black" />
    <br />
    <label>Açıklama</label>
    <input type="text" asp-for="Description" class="form-control" style="border:1px solid black" />
    <br />
    <label>Görsel</label>
    <input type="text" asp-for="ImageUrl" class="form-control" style="border:1px solid black" />
    <br />
    <label>Kaegori</label>
     <select asp-for="CategoryId" asp-items="ViewBag.v" class="form-control" style="border:1px solid black">
        <option value="">-- Seçiniz --</option>
    </select>
    <br />
    <button class="btn btn-primary">Kaydet</button>

</form>