@model About
@{
    ViewData["Title"] = "AboutList";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<h2>Hakkımda</h2>

<table class="table table-bordered">
    <tr>
        <th>#</th>
        <th>Unvan</th>
        <th>Unvan Açıklaması</th>
        <th>Açıklama</th>
        <th>Doğum Günü</th>
        <th>Website</th>
        <th>Telefon</th>
        <th>Şehir</th>
        <th>Yaş</th>
        <th>Email</th>
        <th>Fotoğraf Url</th>
    </tr>
    
        <tr>
            <td>@Model.AboutId</td>
            <td>@Model.Title</td>
            <td>@Model.TitleDescription</td>
            <td>@Model.Description</td>
            <td>@Model.Birthday</td>
            <td>@Model.Website</td>
            <td>@Model.Phone</td>
            <td>@Model.City</td>
            <td>@Model.Age</td>
            <td>@Model.Email</td>
            <td>@Model.ImageUrl</td>
        </tr>
    
</table>

<a href="/About/UpdateAbout/@Model.AboutId" class="btn btn-success">Güncelle</a>