@model About
@{
    ViewData["Title"] = "UpdateAbout";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<h2>Hakkımda Güncelleme</h2>

<form method="post">
    <input type="hidden" asp-for="AboutId"  />
    <label>Unvan</label>
    <input type="text" asp-for="Title" class="form-control" style="border:1px solid black" />
    <br />
    <label>Unvan Açıklaması</label>
    <input type="text" asp-for="TitleDescription" class="form-control" style="border:1px solid black" />
    <br />
    <label>Açıklama</label>
    <input type="text" asp-for="Description" class="form-control" style="border:1px solid black" />
    <br />
    <label>Doğum Günü</label>
    <input type="text" asp-for="Birthday" class="form-control" style="border:1px solid black" />
    <br />
    <label>Website</label>
    <input type="text" asp-for="Website" class="form-control" style="border:1px solid black" />
    <br />
    <label>Telefon</label>
    <input type="tel" asp-for="Phone" class="form-control" style="border:1px solid black" />
    <br />
    <label>Şehir</label>
    <input type="text" asp-for="City" class="form-control" style="border:1px solid black" />
    <br />
    <label>Yaş</label>
    <input type="text" asp-for="Age" class="form-control" style="border:1px solid black" />
    <br />
    <label>Email</label>
    <input type="text" asp-for="Email" class="form-control" style="border:1px solid black" />
    <br />
    <label>Fotoğraf</label>
    <input type="text" asp-for="ImageUrl" class="form-control" style="border:1px solid black" />
    <br />
    <button class="btn btn-success">Kaydet</button>
</form>
