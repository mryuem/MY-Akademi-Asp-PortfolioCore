@model Social
@{
    ViewData["Title"] = "CreateSocial";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<h2>Yeni Medya Hesabı Ekle</h2>

<form method="post">
    <label>Hesap Linki</label>
    <input type="text" asp-for="SocialUrl" class="form-control" style="border:1px solid black" />
    <br />
    <label>İkon</label>
    <input type="text" asp-for="SocialIcon" class="form-control" style="border:1px solid black" />
    <br />
    <button class="btn btn-success">Kaydet</button>
</form>