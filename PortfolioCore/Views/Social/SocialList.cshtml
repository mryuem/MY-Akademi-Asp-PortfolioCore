@model List<Social>
@{
    ViewData["Title"] = "SocialList";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<h2>Sosyal Medya Hesapları</h2>

<table class="table table-bordered">
    <tr>
        <th>#</th>
        <th>Hesap Linki</th>
        <th>İkon</th>
        <th>Sil</th>
        <th>Güncelle</th>
    </tr>
    @foreach(var item in Model)
    {
        <tr>
            <td>@item.SocialId</td>
            <td>@item.SocialUrl</td>
            <td>@item.SocialIcon</td>
            <td><a href="/Social/DeleteSocial/@item.SocialId" class="btn btn-danger">Sil</a></td>
            <td><a href="/Social/UpdateSocial/@item.SocialId" class="btn btn-success">Güncelle</a></td>
        </tr>
    }
</table>
<a href="/Social/CreateSocial/" class="btn btn-primary">Yeni Hesap Ekle</a>