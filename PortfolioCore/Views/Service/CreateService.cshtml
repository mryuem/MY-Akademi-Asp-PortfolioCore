@model Service
@{
    ViewData["Title"] = "CreateService";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<h2>Hizmet Oluştur Sayası</h2>

<form method="post">
    <label>Yetenek Başlığı</label>
    <input type="text" asp-for="ServicesTıtle" class="form-control" style="border:1px solid black" />
    <br />
    <label>Yetenek Değeri</label>
    <input type="text" asp-for="ServicesDescription" class="form-control" style="border:1px solid black" />
    <br />
    <label>Icon</label>
    <input type="text" asp-for="ServiceIcon" class="form-control" style="border:1px solid black" />
    <br />
    <button class="btn btn-info">Hizmet Ekle</button>
</form>